# Copy to .env.local and fill locally. Never commit real values.

# PostgreSQL (local Docker default shown by docker-compose.yml; cloud: Supabase pooled URL)
DATABASE_URL=

# Owner authentication
# AUTH_MODE=local uses a signed cookie from OWNER_PASSPHRASE (refused when VERCEL or DEPLOYED is set).
# AUTH_MODE=supabase uses Supabase Auth magic link (requires the NEXT_PUBLIC_SUPABASE_* keys below; the anon key may be the new publishable key).
AUTH_MODE=local
OWNER_EMAILS=
OWNER_PASSPHRASE=
SESSION_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Postgres for `npm run db:cloud`: session-pooler URL WITHOUT password, plus the raw password
# (percent-encoded by the script). On Vercel, DATABASE_URL is the full pooled URL instead.
SUPABASE_DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Agent adapter: "mock" (offline, deterministic) or "anthropic" (live, spends API credits)
AGENT_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_BUDGET_USD=3
LLM_MAX_REQUESTS=30

# Langfuse (optional; tracing is a no-op without keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_URL=
