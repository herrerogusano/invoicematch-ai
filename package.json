{
  "name": "invoicematch-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Invoice-to-purchase-order reconciliation PoC: one Mastra agent with tools, a durable human-in-the-loop workflow and deterministic money validation.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "eval:offline": "tsx evals/run-offline.ts",
    "eval:live": "tsx evals/run-live.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/provider": "^4.0.27",
    "@mastra/core": "^1.77.0",
    "@mastra/langfuse": "^1.6.0",
    "@mastra/observability": "^1.20.0",
    "@mastra/pg": "^1.31.1",
    "decimal.js": "^10.6.0",
    "next": "^16.4.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
